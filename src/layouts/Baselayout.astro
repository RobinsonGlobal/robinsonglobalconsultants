---
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const { title = "Robinson Global Consultants LLC" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f7f9fc;
        color: #1a1a1a;
      }

      main {
        max-width: 1100px;
        margin: 2rem auto;
        padding: 0 1rem;
      }
    </style>
  </head>

  <body>
    <NavBar />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
