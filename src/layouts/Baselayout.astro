---
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const { title = "Robinson Global Consultants LLC" } = Astro.props;
---

<html lang="en">
 <head>
  <meta name="author" content="Robinson Global Consultants LLC">
  <meta name="theme-color" content="#0A0A0A">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Robinson Global Consultants LLC">
  <meta property="og:url" content="https://robinsonglobalconsultants.com">

  <meta property="og:image" content="/rgc-og-image.png">
  <meta name="twitter:image" content="/rgc-og-image.png">
  <meta property="og:image:alt" content="Robinson Global Consultants LLC">

  <title>Robinson Global Consultants LLC</title>
</head>

<meta property="og:type" content="website">
<meta property="og:site_name" content="Robinson Global Consultants LLC">
<meta property="og:image" content="/og-image.jpg">
<meta property="og:image:alt" content="Robinson Global Consultants LLC">
<meta property="og:url" content="https://robinsonglobalconsultants.com">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="/og-image.jpg">
<meta name="twitter:title" content="Robinson Global Consultants LLC">
<meta name="twitter:description" content="Security, risk management, and operational readiness consulting for corporate, government, and global organizations.">
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style>
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f7f9fc;
        color: #1a1a1a;
      }

      main {
        max-width: 1100px;
        margin: 2rem auto;
        padding: 0 1rem;
      }
    </style>
  </head>

  <body>
    <NavBar />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
