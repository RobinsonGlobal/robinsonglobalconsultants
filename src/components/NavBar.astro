---
const links = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
  { name: "Services", href: "/services" },
  { name: "Contact", href: "/contact" }
];
---

<nav>
  <div class="nav-container">
    <div class="logo">
      Robinson Global Consultants
    </div>

    <ul class="nav-links">
      {links.map(link => (
        <li><a href={link.href}>{link.name}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  nav {
    background: #0a1a2b;
    padding: 1rem 0;
    color: white;
  }

  .nav-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 1.3rem;
    font-weight: bold;
    letter-spacing: 0.5px;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: white;
    text-decoration: none;
    font-size: 1rem;
    transition: opacity 0.2s ease;
  }

  .nav-links a:hover {
    opacity: 0.7;
  }
</style>
