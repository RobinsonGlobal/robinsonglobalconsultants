---
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Robinson Global Consultants LLC">
const experience = [
  "United States Marine Corps — Active Duty (1991–1995)",
  "U.S. Department of State — Diplomatic Security Service",
  "U.S. Immigration & Customs Enforcement — Security & Law Enforcement Leadership",
  "Local Law Enforcement — Supervisory & Operational Roles",
  "International Security Operations — Africa, Middle East, and Global Assignments",
  "Founder — Robinson Global Consultants LLC"
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>About Us — Robinson Global Consultants LLC</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f7f9fc;
        color: #1a1a1a;
      }

      header {
        background: #0a1a2b;
        color: white;
        padding: 2rem;
        text-align: center;
      }

      header h1 {
        margin: 0;
        font-size: 2.5rem;
      }

      .section {
        max-width: 900px;
        margin: 3rem auto;
        padding: 0 1rem;
      }

      .section h2 {
        font-size: 2rem;
        margin-bottom: 1rem;
        color: #0a1a2b;
      }

      .card {
        background: white;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        line-height: 1.6;
      }

      ul {
        margin-top: 1rem;
        padding-left: 1.2rem;
      }

      li {
        margin-bottom: 0.5rem;
      }

      footer {
        text-align: center;
        padding: 2rem;
        background: #0a1a2b;
        color: white;
        margin-top: 3rem;
      }
    </style>
  </head>

  <body>
    <NavBar />
    <header>
      <h1>About Robinson Global Consultants LLC</h1>
      <p>Leadership • Security • Operational Excellence</p>
    </header>

    <div class="section">
      <h2>Who We Are</h2>
      <div class="card">
        <p>
          Robinson Global Consultants LLC is a Metro Atlanta–based security and risk
          management consulting firm built on decades of operational leadership across
          military, federal, and international environments. Our mission is to help
          organizations strengthen their security posture, elevate operational readiness,
          and build disciplined, accountable teams.
        </p>
        <p>
          Founded by DeJuan Robinson, the firm brings a unique blend of Marine Corps
          discipline, federal law enforcement expertise, and global security experience.
          Every engagement is guided by a commitment to integrity, mission focus, and
          operational clarity.
        </p>
      </div>
    </div>

    <div class="section">
      <h2>Professional Background</h2>
      <div class="card">
        <p>
          With more than 30 years of combined experience in military service, federal
          security operations, and organizational leadership, Robinson Global Consultants
          offers a depth of expertise that few firms can match.
        </p>

        <ul>
          {experience.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <div class="section">
      <h2>Our Consulting Philosophy</h2>
      <div class="card">
        <p>
          We believe that strong organizations are built on readiness, accountability,
          and clear operational direction. Our consulting approach emphasizes proactive
          risk mitigation, disciplined leadership, and practical solutions that work in
          real-world environments.
        </p>
        <p>
          Whether supporting corporate security teams, government agencies, or
          international operations, we deliver strategies that enhance safety, strengthen
          processes, and empower leaders to perform at their highest level.
        </p>
      </div>
    </div>

    <footer>
      <p>© {new Date().getFullYear()} Robinson Global Consultants LLC</p>
    </footer>
    <Footer />
  </body>
</html>
</BaseLayout>
