    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f7f9fc;
        color: #1a1a1a;
      }

      header {
        background: #0a1a2b;
        color: white;
        padding: 2rem;
        text-align: center;
      }

      header h1 {
        margin: 0;
        font-size: 2.5rem;
      }

