---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Services — Robinson Global Consultants LLC">
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <title>Services — Robinson Global Consultants LLC</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <style>
        body {
          margin: 0;
          font-family: Arial, Helvetica, sans-serif;
          background: #f7f9fc;
          color: #1a1a1a;
        }

        .section {
          max-width: 1100px;
          margin: 3rem auto;
          padding: 0 1rem;
        }

        .section h1 {
          font-size: 2.5rem;
          margin-bottom: 1rem;
          color: #0a1a2b;
        }

        .card {
          background: white;
          padding: 2rem;
          border-radius: 8px;
          box-shadow: 0 2px 8px rgba(0,0,0,0.05);
          line-height: 1.6;
          margin-bottom: 2rem;
        }

        .card h2 {
          margin-top: 1rem;
          color: #0a1a2b;
        }

        .card p {
          margin: 0.8rem 0;
        }

        ul {
          margin: 1rem 0;
          padding-left: 1.2rem;
        }

        ul li {
          margin: 0.5rem 0;
        }
      </style>
    </head>

    <body>
      <NavBar />

      <div class="section">
        <h1>Our Services</h1>

        <div class="card">
          <h2>Security Assessments & Risk Management</h2>
          <p>
            We help organizations identify vulnerabilities, strengthen physical security,
            and implement practical, mission‑aligned risk mitigation strategies. Our
            assessments are grounded in real‑world operational experience across federal,
            corporate, and international environments.
          </p>
          <ul>
            <li>Comprehensive security assessments</li>
            <li>Risk and threat analysis</li>
            <li>Physical security evaluations (CCTV, access control, alarms)</li>
            <li>Policy and procedure review</li>
          </ul>
        </div>

        <div class="card">
          <h2>Operational Readiness & Crisis Planning</h2>
          <p>
            Strong organizations are built on readiness, accountability, and disciplined
            operational direction. We support leaders in building crisis‑ready teams and
            establishing processes that perform under pressure.
          </p>
          <ul>
            <li>Emergency and crisis planning</li>
            <li>Operational readiness evaluations</li>
            <li>Incident response planning</li>
            <li>Continuity of operations (COOP) support</li>
          </ul>
        </div>

        <div class="card">
          <h2>Leadership Advisory & Organizational Discipline</h2>
          <p>
            With decades of leadership experience across military, federal, and global
            security environments, we help organizations build disciplined, accountable
            teams capable of executing mission‑critical objectives.
          </p>
          <ul>
            <li>Leadership coaching and advisory</li>
            <li>Organizational discipline development</li>
            <li>Team performance optimization</li>
            <li>Executive guidance on security and operations</li>
          </ul>
        </div>

        <div class="card">
          <h2>Corporate & Government Security Support</h2>
          <p>
            We provide strategic support for corporate security departments, government
            agencies, and international operations seeking to enhance safety, strengthen
            processes, and elevate operational performance.
          </p>
          <ul>
            <li>Security program development</li>
            <li>Policy creation and refinement</li>
            <li>Protective operations guidance</li>
            <li>International security support</li>
          </ul>
        </div>
      </div>

      <Footer />
    </body>
  </html>
</BaseLayout>
