---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import HeroBanner from "../components/HeroBanner.astro";
import ConsultationSection from "../components/ConsultationSection.astro";
---

<BaseLayout title="Robinson Global Consultants LLC — Security • Risk • Leadership">
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <title>Robinson Global Consultants LLC</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <style>
        body {
          margin: 0;
          font-family: Arial, Helvetica, sans-serif;
          background: #f7f9fc;
          color: #1a1a1a;
        }

        .section {
          max-width: 1100px;
          margin: 3rem auto;
          padding: 0 1rem;
        }

        .section h2 {
          font-size: 2.2rem;
          margin-bottom: 1rem;
          color: #0a1a2b;
        }

        .intro {
          background: white;
          padding: 2rem;
          border-radius: 8px;
          box-shadow: 0 2px 8px rgba(0,0,0,0.05);
          line-height: 1.6;
        }
      </style>
    </head>

    <body>
      <NavBar />

      <HeroBanner />

      <div class="section">
        <h2>Strategic Security & Operational Leadership</h2>
        <div class="intro">
          <p>
            Robinson Global Consultants LLC delivers disciplined, mission‑focused security and
            operational solutions for organizations across corporate, government, and
            international environments. With over 30 years of combined experience in federal
            law enforcement, diplomatic security, and organizational leadership, we help clients
            strengthen readiness, reduce risk, and elevate operational performance.
          </p>
        </div>
      </div>

      <ConsultationSection />

      <Footer />
    </body>
  </html>
</BaseLayout>
