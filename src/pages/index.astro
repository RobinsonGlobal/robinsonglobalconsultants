          disciplined leadership, proactive risk mitigation, and operational excellence.
        </p>
      </div>
    </div>

    <div class="section">
      <h2>Core Services</h2>
      <div class="services">
        {services.map(service => (
          <div class="service-card">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="section">
