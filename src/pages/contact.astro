---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const contactInfo = {
  email: "info@robinsonglobalconsultants.com",
  location: "Metro Atlanta, GA",
  availability: "Monday–Friday • 9:00 AM – 5:00 PM EST"
};
---

<BaseLayout title="Contact — Robinson Global Consultants LLC">
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <title>Contact — Robinson Global Consultants LLC</title>
<meta name="description" content="Contact Robinson Global Consultants LLC for security consulting, risk management, operational readiness, and leadership advisory services.">
      <style>
        body {
          margin: 0;
          font-family: Arial, Helvetica, sans-serif;
          background: #f7f9fc;
          color: #1a1a1a;
        }

        header {
          background: #0a1a2b;
          color: white;
          padding: 2rem;
          text-align: center;
        }

        header h1 {
          margin: 0;
          font-size: 2.5rem;
        }

        .section {
          max-width: 900px;
          margin: 3rem auto;
          padding: 0 1rem;
        }

        .section h2 {
          font-size: 2rem;
          margin-bottom: 1rem;
          color: #0a1a2b;
        }

        .card {
          background: white;
          padding: 2rem;
          border-radius: 8px;
          box-shadow: 0 2px 8px rgba(0,0,0,0.05);
          line-height: 1.6;
        }

        .contact-details p {
          margin: 0.5rem 0;
        }

        form {
          margin-top: 2rem;
          display: grid;
          gap: 1rem;
        }

        input, textarea {
          width: 100%;
          padding: 0.8rem;
          border: 1px solid #ccc;
          border-radius: 6px;
          font-size: 1rem;
        }

        textarea {
          min-height: 120px;
        }

        button {
          background: #0a1a2b;
          color: white;
          padding: 0.8rem 1.2rem;
          border: none;
          border-radius: 6px;
          font-size: 1rem;
          cursor: pointer;
        }

        button:hover {
          background: #0d253d;
        }

        footer {
          text-align: center;
          padding: 2rem;
          background: #0a1a2b;
          color: white;
          margin-top: 3rem;
        }
      </style>
    </head>

    <body>
      <NavBar />

      <header>
        <h1>Contact Us</h1>
        <p>Let’s strengthen your organization together</p>
      </header>

      <div class="section">
        <h2>Get in Touch</h2>
        <div class="card">
          <p>
            Robinson Global Consultants LLC is committed to delivering strategic, disciplined,
            and mission‑focused solutions for organizations across corporate, government, and
            international environments. Whether you need a security assessment, operational
            readiness support, or leadership advisory services, we’re ready to assist.
          </p>

          <div class="contact-details">
            <p><strong>Email:</strong> {contactInfo.email}</p>
            <p><strong>Location:</strong> {contactInfo.location}</p>
            <p><strong>Availability:</strong> {contactInfo.availability}</p>
          </div>

          <form>
            <input type="text" name="name" placeholder="Your Name" required />
            <input type="email" name="email" placeholder="Your Email" required />
            <textarea name="message" placeholder="Your Message" required></textarea>
            <button type="submit">Send Message</button>
          </form>

          <p style="margin-top: 1rem; font-size: 0.9rem; opacity: 0.8;">
            *This form is currently static. We can connect it to a backend when you're ready.
          </p>
        </div>
      </div>

      <footer>
        <p>© {new Date().getFullYear()} Robinson Global Consultants LLC</p>
      </footer>

      <Footer />
    </body>
  </html>
</BaseLayout>
